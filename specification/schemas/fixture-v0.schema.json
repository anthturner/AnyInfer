{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture-v0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "id",
    "family",
    "profile",
    "description",
    "request",
    "route",
    "adapter",
    "expected"
  ],
  "properties": {
    "fixture_version": {
      "const": "0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "core-generation"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "extension": {
      "enum": [
        "schema.ref",
        "schema.combinators",
        "schema.other_dialects",
        "schema.boolean_subschema",
        "schema.unknown_keywords_ignored",
        "messages.tool_role",
        "targets.alias",
        "messages.non_text_parts"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms"
      ],
      "properties": {
        "start_ms": {
          "type": "integer"
        }
      }
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "expected": {
      "$ref": "#/$defs/expected"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "extension": {
            "const": "messages.non_text_parts"
          }
        },
        "required": [
          "extension"
        ]
      },
      "else": {
        "properties": {
          "request": {
            "properties": {
              "messages": {
                "items": {
                  "$ref": "#/$defs/literal_message"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "json": {},
    "number": {
      "type": "number"
    },
    "literal_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "input_part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "image_url"
            },
            "url": {
              "type": "string",
              "pattern": "^https://example\\.invalid/"
            },
            "media_type": {
              "type": "string",
              "default": "image/png"
            }
          }
        }
      ]
    },
    "input_message": {
      "oneOf": [
        {
          "$ref": "#/$defs/literal_message"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "parts"
          ],
          "properties": {
            "role": {
              "enum": [
                "system",
                "user",
                "assistant",
                "tool"
              ]
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/input_part"
              }
            }
          }
        }
      ]
    },
    "expected_segment": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema_prompt"
          ],
          "properties": {
            "$schema_prompt": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$repair_feedback"
          ],
          "properties": {
            "$repair_feedback": {
              "const": true
            }
          }
        }
      ]
    },
    "expected_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expected_segment"
              }
            }
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_message"
          }
        },
        "schema": {},
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "top_p": {
              "type": [
                "number",
                "null"
              ]
            },
            "presence_penalty": {
              "type": [
                "number",
                "null"
              ]
            },
            "frequency_penalty": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_output_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stop": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer"
            }
          }
        },
        "timeout_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "consume": {
          "type": "string",
          "pattern": "^(buffered|stream|stream_cancel_after_events:[1-9][0-9]*|close_without_advance|close_twice_after_end)$"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "backoff_base_s": {
              "$ref": "#/$defs/number"
            },
            "backoff_max_s": {
              "$ref": "#/$defs/number"
            }
          }
        },
        "health_gate": {
          "type": "boolean"
        },
        "health_ttl_s": {
          "$ref": "#/$defs/number"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_repair_attempts",
        "models",
        "health_preset",
        "script"
      ],
      "properties": {
        "max_repair_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilities"],
            "properties": {
              "capabilities": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grammar", "json_schema", "json_mode"],
                "properties": {
                  "grammar": {"const": false},
                  "json_schema": {"const": false},
                  "json_mode": {"const": false}
                }
              }
            }
          }
        },
        "health_preset": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "failed_at_ms"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "failed_at_ms": {
                "type": "integer"
              }
            }
          }
        },
        "script": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/script_entry"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "instance_path",
        "schema_path",
        "params"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "instance_path": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_path": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "enum": [
                  "response_empty",
                  "no_json_candidate",
                  "malformed_json_candidate"
                ]
              }
            },
            "required": [
              "rule"
            ]
          },
          "then": {
            "properties": {
              "instance_path": {
                "type": "null"
              },
              "schema_path": {
                "type": "null"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "rule": {
                  "const": "invalid_schema"
                }
              },
              "required": [
                "rule"
              ]
            },
            "then": {
              "properties": {
                "instance_path": {
                  "type": "null"
                },
                "schema_path": {
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "instance_path": {
                  "type": "array"
                },
                "schema_path": {
                  "type": "array"
                }
              }
            }
          }
        }
      ]
    },
    "usage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_read_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_write_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reasoning_tokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "script_event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usage"
          ],
          "properties": {
            "usage": {
              "$ref": "#/$defs/usage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "final"
          ],
          "properties": {
            "final": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls",
                    "content_filter",
                    "other"
                  ],
                  "default": "stop"
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "await_release"
          ],
          "properties": {
            "await_release": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "script_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fail"
          ],
          "properties": {
            "fail": {
              "$ref": "#/$defs/script_failure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events"
          ],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/script_event"
              }
            },
            "fail": {
              "$ref": "#/$defs/script_failure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "fail_in_cleanup"
          ],
          "properties": {
            "events": {
              "type": "array",
              "contains": {
                "required": [
                  "final"
                ]
              },
              "items": {
                "$ref": "#/$defs/script_event"
              }
            },
            "fail_in_cleanup": {
              "$ref": "#/$defs/script_failure"
            }
          }
        }
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "role",
        "mechanism",
        "timeout_s",
        "max_response_bytes",
        "messages"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "role": {
          "enum": [
            "original",
            "correction"
          ]
        },
        "mechanism": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "prompt",
            "json_mode",
            "json_schema",
            "grammar"
          ]
        },
        "timeout_s": {
          "type": "number"
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expected_message"
              }
            },
            {
              "type": "string",
              "pattern": "^same_as_call_[1-9][0-9]*$"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "correction"
              }
            }
          },
          "then": {
            "required": [
              "issues"
            ]
          },
          "else": {
            "not": {
              "required": [
                "issues"
              ]
            }
          }
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "category"
              ],
              "properties": {
                "category": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "none"
          ],
          "properties": {
            "none": {
              "const": true
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "calls",
        "clock_advances_ms",
        "telemetry",
        "events",
        "outcome",
        "accounting"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "to_be_observed"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "clock_advances_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repair_attempted",
            "parameter_dropped"
          ],
          "properties": {
            "repair_attempted": {
              "type": "array"
            },
            "parameter_dropped": {
              "type": "array"
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "accounting": {
          "const": null
        }
      }
    },
    "script_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "enum": [
            "auth",
            "rate_limit",
            "transport",
            "provider_unavailable",
            "model_not_found",
            "context_length",
            "stream_protocol",
            "unsupported_input"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "configure",
            "discover",
            "generate",
            "stream",
            "validate",
            "cleanup",
            null
          ]
        }
      }
    }
  }
}
