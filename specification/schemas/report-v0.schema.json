{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-v0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["report_version", "release", "release_sha256", "implementation", "cases", "counts"],
  "properties": {
    "report_version": {"const": "0"},
    "release": {"type": "string", "minLength": 1},
    "release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["name", "version", "source_revision", "driver_revision", "runtime", "os", "dependencies", "extensions"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}, "driver_revision": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "dependencies": {"type": "object", "additionalProperties": {"type": "string"}}, "extensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["schema.ref", "schema.combinators", "schema.other_dialects", "schema.boolean_subschema", "schema.unknown_keywords_ignored", "messages.tool_role", "targets.alias", "messages.non_text_parts"]}}}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["pass", "fail", "error", "extension"], "properties": {"pass": {"type": "integer", "minimum": 0}, "fail": {"type": "integer", "minimum": 0}, "error": {"type": "integer", "minimum": 0}, "extension": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "driver_evidence": {"type": "object", "additionalProperties": false, "required": ["recipe_ref", "observations"], "properties": {"recipe_ref": {"type": "string", "minLength": 1}, "observations": {"type": "object", "minProperties": 1}}},
    "native_outcome": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["result"], "properties": {"result": {"type": "object"}}}, {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["category", "native_type", "message"], "properties": {"category": {"type": ["string", "null"]}, "native_type": {"type": "string", "minLength": 1}, "message": {"type": "string", "maxLength": 4096}}}}}, {"type": "object", "additionalProperties": false, "required": ["none"], "properties": {"none": {"const": true}}}]},
    "extension_evidence": {"type": "object", "additionalProperties": false, "required": ["native_outcome", "adapter_entries"], "properties": {"native_outcome": {"$ref": "#/$defs/native_outcome"}, "adapter_entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["entry_ordinal", "model", "role", "timeout_s", "max_response_bytes"], "properties": {"entry_ordinal": {"type": "integer", "minimum": 0}, "model": {"type": "string", "minLength": 1}, "role": {"enum": ["original", "correction"]}, "timeout_s": {"type": "number", "minimum": 0}, "max_response_bytes": {"type": "integer", "minimum": 0}}}}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "verdict", "detail"], "properties": {"id": {"type": "string", "minLength": 1}, "verdict": {"enum": ["pass", "fail", "error", "extension"]}, "detail": {"type": ["string", "null"]}, "evidence": {}}, "allOf": [{"if": {"properties": {"verdict": {"const": "extension"}}, "required": ["verdict"]}, "then": {"required": ["evidence"], "properties": {"evidence": {"$ref": "#/$defs/extension_evidence"}}}, "else": {"if": {"properties": {"id": {"pattern": "^driver/"}, "verdict": {"const": "pass"}}, "required": ["id", "verdict"]}, "then": {"required": ["evidence"], "properties": {"evidence": {"$ref": "#/$defs/driver_evidence"}}}, "else": {"properties": {"evidence": {"type": "null"}}}}}]}
  }
}
