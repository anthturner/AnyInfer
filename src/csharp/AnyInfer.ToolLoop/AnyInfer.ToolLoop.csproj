<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <ToolLoopSourceDirty Condition="'$(ToolLoopSourceDirty)' == ''">true</ToolLoopSourceDirty>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AnyInfer/AnyInfer.csproj" />
    <AssemblyMetadata Include="ToolLoopSourceDirty" Value="$(ToolLoopSourceDirty)" />
  </ItemGroup>
</Project>
