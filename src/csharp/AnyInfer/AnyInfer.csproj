<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnyInfer</AssemblyName>
    <RootNamespace>AnyInfer</RootNamespace>
    <PackageId>AnyInfer</PackageId>
    <Authors>Anthony Turner</Authors>
    <Description>A bounded .NET 8 inference core for application-owned provider adapters.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/anthturner/AnyInfer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</RepositoryCommit>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="[8.0.5]" />
    <PackageReference Include="PeterO.Numbers" Version="[1.8.2]" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
    <EmbeddedResource Include="../../python/anyinfer/catalog/default.json" LogicalName="AnyInfer.Catalog.default.json" />
    <EmbeddedResource Include="../../python/anyinfer/catalog/models.json" LogicalName="AnyInfer.Catalog.models.json" />
    <EmbeddedResource Include="../../python/anyinfer/capabilities/pricing.json" LogicalName="AnyInfer.Capabilities.pricing.json" />
    <EmbeddedResource Include="Manifest/manifest.schema.json" LogicalName="AnyInfer.Manifest.manifest.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnyInfer.Tests" />
    <InternalsVisibleTo Include="AnyInfer.Conformance" />
  </ItemGroup>
</Project>
