{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/maintenance/run-report-v1.json",
  "title": "Provider-change aggregation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "workflow_run", "trusted_pr_head", "evaluated_source", "registry_sha256", "input_sha256", "inventory_artifacts", "verification_artifacts"],
  "properties": {"schema_version": {"const": 1}, "producer": {"$ref": "#/$defs/producer"}, "workflow_run": {"$ref": "#/$defs/workflow"}, "trusted_pr_head": {"$ref": "#/$defs/commit"}, "evaluated_source": {"$ref": "#/$defs/source"}, "registry_sha256": {"$ref": "#/$defs/sha"}, "input_sha256": {"$ref": "#/$defs/sha"}, "inventory_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "verification_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}},
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "workflow": {"type": "object", "additionalProperties": false, "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}}, "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty", "input_fingerprint"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "dirty": {"type": "boolean"}, "input_fingerprint": {"$ref": "#/$defs/sha"}}}, "artifact": {"type": "object", "additionalProperties": false, "required": ["implementation_id", "sha256"], "properties": {"implementation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "sha256": {"$ref": "#/$defs/sha"}}}}
}
