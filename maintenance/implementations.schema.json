{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/maintenance/implementations-v1.json",
  "title": "Registered maintenance implementations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "non_inference_contracts", "implementations"],
  "properties": {"schema_version": {"const": 1}, "non_inference_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}}, "implementations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implementation"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contract": {"type": "string", "pattern": "^contracts/[a-z0-9-]+\\.md$"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["id", "language", "root", "exporter_argv", "gates", "profile_claims"], "properties": {"id": {"$ref": "#/$defs/id"}, "language": {"type": "string", "minLength": 1}, "root": {"$ref": "#/$defs/path"}, "exporter_argv": {"$ref": "#/$defs/argv"}, "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "argv"], "properties": {"id": {"$ref": "#/$defs/id"}, "argv": {"$ref": "#/$defs/argv"}}}}, "profile_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "planned_exporter": {"type": "boolean"}}}
  }
}
