{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/maintenance/binding-inventory-v1.json",
  "title": "Provider binding inventory evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_id", "producer", "workflow_run", "trusted_pr_head", "evaluated_source", "registry_sha256", "input_sha256", "bindings"],
  "properties": {"schema_version": {"const": 1}, "implementation_id": {"$ref": "#/$defs/id"}, "producer": {"$ref": "#/$defs/producer"}, "workflow_run": {"$ref": "#/$defs/workflow"}, "trusted_pr_head": {"$ref": "#/$defs/commit"}, "evaluated_source": {"$ref": "#/$defs/source"}, "registry_sha256": {"$ref": "#/$defs/sha"}, "input_sha256": {"$ref": "#/$defs/sha"}, "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "workflow": {"type": "object", "additionalProperties": false, "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}}, "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty", "input_fingerprint"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "dirty": {"type": "boolean"}, "input_fingerprint": {"$ref": "#/$defs/sha"}}}, "binding": {"type": "object", "additionalProperties": false, "required": ["provider_id", "operation", "contract_dependencies"], "properties": {"provider_id": {"$ref": "#/$defs/id"}, "operation": {"enum": ["generation", "embedding", "rerank", "batch"]}, "contract_dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^contracts/[a-z0-9-]+\\.md(?:#[A-Za-z0-9_.-]+)?$"}}}}}
}
