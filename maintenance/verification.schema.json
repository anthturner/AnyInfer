{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/maintenance/verification-v1.json",
  "title": "Provider-change gate verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_id", "producer", "workflow_run", "trusted_pr_head", "evaluated_source", "registry_sha256", "input_sha256", "gates"],
  "properties": {"schema_version": {"const": 1}, "implementation_id": {"$ref": "#/$defs/id"}, "producer": {"$ref": "#/$defs/producer"}, "workflow_run": {"$ref": "#/$defs/workflow"}, "trusted_pr_head": {"$ref": "#/$defs/commit"}, "evaluated_source": {"$ref": "#/$defs/source"}, "registry_sha256": {"$ref": "#/$defs/sha"}, "input_sha256": {"$ref": "#/$defs/sha"}, "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "workflow": {"type": "object", "additionalProperties": false, "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}}, "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty", "input_fingerprint"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "dirty": {"type": "boolean"}, "input_fingerprint": {"$ref": "#/$defs/sha"}}}, "gate": {"type": "object", "additionalProperties": false, "required": ["id", "status", "exit_code", "output_sha256", "log_sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"enum": ["passed", "failed", "skipped"]}, "exit_code": {"type": "integer", "minimum": 0}, "output_sha256": {"$ref": "#/$defs/sha"}, "log_sha256": {"$ref": "#/$defs/sha"}}}}
}
