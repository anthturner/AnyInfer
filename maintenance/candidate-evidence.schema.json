{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/maintenance/candidate-evidence-v1.json",
  "title": "Candidate qualification evidence wrapper",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "input_sha256", "registry_sha256", "release_id", "profile", "profile_revision", "input_revision_a", "candidate_commit_b", "candidate_tree_b", "candidate_manifest", "reference", "normative", "inventory", "schemas", "case_inputs", "assets", "support_claimset", "reports", "review"],
  "properties": {
    "schema_version": {"const": 1}, "input_sha256": {"$ref": "#/$defs/sha"}, "registry_sha256": {"$ref": "#/$defs/sha"}, "release_id": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}, "profile_revision": {"type": "string", "minLength": 1}, "input_revision_a": {"$ref": "#/$defs/revision"}, "candidate_commit_b": {"$ref": "#/$defs/revision"}, "candidate_tree_b": {"$ref": "#/$defs/revision"}, "candidate_manifest": {"$ref": "#/$defs/file"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "environment_path", "environment_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "environment_path": {"$ref": "#/$defs/path"}, "environment_sha256": {"$ref": "#/$defs/sha"}}},
    "normative": {"type": "object", "additionalProperties": false, "required": ["readme", "maintenance", "profile"], "properties": {"readme": {"$ref": "#/$defs/file"}, "maintenance": {"$ref": "#/$defs/file"}, "profile": {"$ref": "#/$defs/file"}}},
    "inventory": {"$ref": "#/$defs/file"}, "schemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "case_inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}}}}, "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "support_claimset": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reports": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["implementation_id", "path", "sha256", "run_identity"], "properties": {"implementation_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "run_identity": {"type": "object"}}}}, "review": {"type": "object", "additionalProperties": false, "required": ["identity", "disposition"], "properties": {"identity": {"type": "string", "minLength": 1}, "disposition": {"enum": ["approved", "rejected"]}}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}}}}
}
