      "properties": {"runtime_type": {"enum": ["ProviderError", "ProviderUnavailableError", "ContextLengthError", "SpendLimitError", "AllTargetsFailedError"]}, "provider": {"type": ["string", "null"]}, "phase": {"type": ["string", "null"]}, "retryable": {"type": "boolean"}, "http_status": {"type": ["integer", "null"]}, "retry_after_s": {"type": ["number", "null"]}, "limit_usd": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "spent_usd": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "estimated_usd": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}},
      "allOf": [{"if": {"properties": {"runtime_type": {"const": "SpendLimitError"}}}, "then": {"required": ["limit_usd", "spent_usd", "estimated_usd"]}, "else": {"properties": {"limit_usd": {"type": "null"}, "spent_usd": {"type": "null"}, "estimated_usd": {"type": "null"}}}}]
