    "attempt_error_any": {"oneOf": [{"$ref": "#/$defs/python_attempt_error"}, {"$ref": "#/$defs/csharp_attempt_error"}]},
    "request_failed_error_any": {"oneOf": [{"$ref": "#/$defs/python_request_failed_error"}, {"$ref": "#/$defs/csharp_request_failed_error"}]},
    "python_terminal_error": {
