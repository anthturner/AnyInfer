        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "name"], "properties": {"type": {"const": "timing_mark"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "name": {"enum": ["first_token", "last_token"]}}}
      ]
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "operation_index", "script_id", "instance"],
      "properties": {
        "type": {"enum": ["handler_entry", "body_ready", "body_released", "body_closed", "stream_closed", "cancel_requested", "pending_observed", "client_closed", "handler_closed", "adapter_closed"]},
        "operation_index": {"anyOf": [{"$ref": "#/$defs/nonnegative"}, {"type": "null"}]}, "script_id": {"type": ["string", "null"]}, "instance": {"type": ["string", "null"]}
      }
    },
    "telemetry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "targets"], "properties": {"type": {"const": "RequestStarted"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "targets": {"type": "array", "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "target"], "properties": {"type": {"const": "TargetResolved"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "target": {"$ref": "#/$defs/name"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "attempt", "target"], "properties": {"type": {"const": "AttemptStarted"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "attempt": {"$ref": "#/$defs/nonnegative"}, "target": {"$ref": "#/$defs/name"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "outcome"], "properties": {"type": {"const": "AttemptCompleted"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "outcome": {"const": "ok"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "attempt", "error"], "properties": {"type": {"const": "RetryScheduled"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "attempt": {"$ref": "#/$defs/nonnegative"}, "error": {"$ref": "#/$defs/attempt_error_any"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "source", "destination", "error"], "properties": {"type": {"const": "FallbackTriggered"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "source": {"$ref": "#/$defs/name"}, "destination": {"$ref": "#/$defs/name"}, "error": {"$ref": "#/$defs/attempt_error_any"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "count", "mechanism"], "properties": {"type": {"const": "RepairAttempted"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "count": {"$ref": "#/$defs/nonnegative"}, "mechanism": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "field", "method"], "properties": {"type": {"const": "UsageEstimated"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "field": {"type": "string"}, "method": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "target", "usage", "repair_attempts"], "properties": {"type": {"const": "RequestCompleted"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "target": {"$ref": "#/$defs/name"}, "usage": {"anyOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]}, "repair_attempts": {"$ref": "#/$defs/nonnegative"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "error"], "properties": {"type": {"const": "RequestFailed"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "error": {"$ref": "#/$defs/request_failed_error_any"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "mechanism", "count", "estimated_tokens"], "properties": {"type": {"const": "CachePlanned"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "mechanism": {"enum": ["none", "explicit", "implicit"]}, "count": {"$ref": "#/$defs/nonnegative"}, "estimated_tokens": {"type": ["integer", "null"]}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "parameter", "reason"], "properties": {"type": {"const": "ParameterDropped"}, "operation_index": {"$ref": "#/$defs/nonnegative"}, "parameter": {"type": "string"}, "reason": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "target", "code", "severity"], "properties": {"type": {"const": "ProviderDiagnostic"}, "operation_index": {"anyOf": [{"$ref": "#/$defs/nonnegative"}, {"type": "null"}]}, "target": {"type": ["string", "null"]}, "code": {"type": "string"}, "severity": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "operation_index", "provider", "remaining", "reset"], "properties": {"type": {"const": "RateLimitObserved"}, "operation_index": {"anyOf": [{"$ref": "#/$defs/nonnegative"}, {"type": "null"}]}, "provider": {"type": ["string", "null"]}, "remaining": {"type": ["integer", "null"]}, "reset": {"type": ["string", "null"]}}}
      ]
