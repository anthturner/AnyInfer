      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "output_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "total_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "cache_read_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "cache_write_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "reasoning_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "cost_usd": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "search_units": {"$ref": "#/$defs/nullable_nonnegative"},
        "server_tool_uses": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}}
      }
    },
    "manifest_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "cost_usd", "search_units"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "output_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "total_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "cache_read_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "cache_write_tokens": {"$ref": "#/$defs/nullable_nonnegative"}, "reasoning_tokens": {"$ref": "#/$defs/nullable_nonnegative"},
        "cost_usd": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "search_units": {"$ref": "#/$defs/nullable_nonnegative"}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "complete", "request_id_relation", "usage", "payload"],
