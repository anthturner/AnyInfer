{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anyinfer.dev/schemas/request-policy-v1-observations.schema.json",
  "title": "request-policy-v1 typed observation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "runtime", "source_revision", "source_dirty", "corpus_sha256", "observations"],
  "properties": {
    "profile": {"const": "request-policy-v1"},
    "runtime": {"enum": ["python", "csharp"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_dirty": {"type": "boolean"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observations": {"type": "array", "minItems": 1}
  },
  "oneOf": [
    {"properties": {"runtime": {"const": "python"}, "observations": {"items": {"$ref": "#/$defs/python_observation"}}}},
    {"properties": {"runtime": {"const": "csharp"}, "observations": {"items": {"$ref": "#/$defs/csharp_observation"}}}}
  ],
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "text": {"type": "string"},
    "money": {"type": "string", "minLength": 1},
    "nonnegative": {"type": "integer", "minimum": 0},
    "nullable_nonnegative": {"type": ["integer", "null"], "minimum": 0},
    "json": {
      "oneOf": [
        {"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"},
