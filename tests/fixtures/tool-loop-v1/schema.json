{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-loop-v1/schema.json",
  "type": "object",
  "properties": {
    "profile": {
      "const": "tool-loop-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "scripts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "required": [
    "profile",
    "cases",
    "scripts"
  ],
  "additionalProperties": false,
  "$defs": {
    "json": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "additionalProperties": false
    },
    "handler": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "constant"
            },
            "async": {
              "type": "boolean"
            },
            "value": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "kind",
            "async",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "echo"
            },
            "async": {
              "type": "boolean"
            },
            "argument": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "async",
            "argument"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "counter"
            },
            "async": {
              "type": "boolean"
            },
            "start": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "async",
            "start"
          ],
          "additionalProperties": false
        }
      ]
    },
    "call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "finish_reason": {
          "enum": [
            "stop",
            "tool_calls"
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "text",
        "tool_calls",
        "finish_reason"
      ],
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/response"
          }
        }
      },
      "required": [
        "id",
        "responses"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "retry": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_attempts"
          ],
          "additionalProperties": false
        },
        "health_gate": {
          "type": "boolean"
        }
      },
      "required": [
        "retry",
        "health_gate"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "entry_point": {
          "enum": [
            "async_run_tools",
            "sync_run_tools"
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "max_rounds": {
          "type": "integer"
        },
        "tool_choice": {
          "const": "auto"
        }
      },
      "required": [
        "entry_point",
        "messages",
        "target",
        "max_rounds",
        "tool_choice"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "client": {
          "type": "object",
          "properties": {
            "context_gate": {
              "type": "boolean"
            },
            "use_default_catalog": {
              "type": "boolean"
            },
            "route": {
              "$ref": "#/$defs/route"
            }
          },
          "required": [
            "context_gate",
            "use_default_catalog",
            "route"
          ],
          "additionalProperties": false
        },
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "spec": {
                "$ref": "#/$defs/spec"
              },
              "handler": {
                "$ref": "#/$defs/handler"
              }
            },
            "required": [
              "spec",
              "handler"
            ],
            "additionalProperties": false
          }
        },
        "script_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "request",
        "client",
        "registrations",
        "script_id"
      ],
      "additionalProperties": false
    }
  }
}
